new file mode 100644
index 0000000000000000000000000000000000000000..b6cce138901f6f6c84851ee8f3b1f640c97d97d0
--- /dev/null
+++ b/packages/mcp/mcp-client/tests/output-contract.spec.ts
@@ -0,0 +1,90 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { Client } from '@modelcontextprotocol/sdk/client/index.js'
+import { InMemoryTransport } from '@modelcontextprotocol/sdk/inMemory.js'
+import { Context } from '@deepseek-ai/cordis'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { syncTools, type ToolDisposers } from '@deepseek-ai/dsh-mcp-client/src/tools.ts'
+
+const integerSchema = {
+  type: 'object', properties: { n: { type: 'integer' } }, required: ['n'], additionalProperties: false,
+}
+const draft7Schema = { ...integerSchema, $schema: 'http://json-schema.org/draft-07/schema#' }
+const textContent = [{ type: 'text', text: 'remote output' }]
+const options = { serverName: 'srv', toolCallTimeoutMs: 1000, registrationFailure: 'throw' } as const
+
+/** Real SDK transport and registry; only the remote server's wire responses are scripted. */
+describe('advertised MCP output validation through ToolRuntime', () => {
+  let ctx: Context
+  let client: Client
+  let serverTransport: InMemoryTransport
+  let registrations: ToolDisposers
+  let outputSchema: Record<string, unknown> | undefined
+  let response: Record<string, unknown>
+  let discoveryError: boolean
+
+  beforeEach(async () => {
+    registrations = new Map()
+    outputSchema = draft7Schema
+    response = { content: textContent, structuredContent: { n: 1 } }
+    discoveryError = false
+    ctx = new Context()
+    await ctx.plugin(SystemPrompt)
+    await ctx.plugin(ToolRuntime)
+    const pair = InMemoryTransport.createLinkedPair()
+    serverTransport = pair[1]
+    serverTransport.onmessage = (message) => {
+      if (!('id' in message) || !('method' in message)) return
+      const params = 'params' in message ? message.params : undefined
+      if (message.method === 'tools/list' && discoveryError) {
+        void serverTransport.send({ jsonrpc: '2.0', id: message.id, error: { code: -32603, message: 'discovery failed' } })
+        return
+      }
+      const result = message.method === 'initialize'
+        ? {
+          protocolVersion: params && 'protocolVersion' in params ? params.protocolVersion : '2025-11-25',
+          capabilities: { tools: {} }, serverInfo: { name: 'output-fixture', version: '1' },
+        }
+        : message.method === 'tools/list'
+          ? { tools: [{ name: 'probe', inputSchema: { type: 'object' }, ...outputSchema === undefined ? {} : { outputSchema } }] }
+          : response
+      void serverTransport.send({ jsonrpc: '2.0', id: message.id, result })
+    }
+    await serverTransport.start()
+    client = new Client({ name: 'output-contract-test', version: '1' })
+    await client.connect(pair[0])
+  })
+
+  afterEach(async () => {
+    for (const dispose of registrations.values()) dispose()
+    try {
+      await client?.close()
+    } finally {
+      await serverTransport?.close()
+    }
+  })
+
+  async function sync() {
+    registrations = await syncTools(client, ctx, options, registrations)
+  }
+
+  function execute() {
+    return ctx.tools.execute({
+      signal: new AbortController().signal,
+      callId: ToolCallId('output-probe'), name: 'mcp__srv__probe', arguments: {},
+    })
+  }
+
+  it.each([
+    ['supported integer', integerSchema],
+    ['same integer with draft-07 annotation', draft7Schema],
+  ])('enforces %s without changing valid output', async (_name, schema) => {
+    outputSchema = schema
+    await sync()
+    expect(await execute()).toMatchObject({ isError: false, value: response })
+    response = { content: textContent, structuredContent: { n: '1' } }
+    expect(await execute()).toMatchObject({ isError: true })
+  })
+
+})
