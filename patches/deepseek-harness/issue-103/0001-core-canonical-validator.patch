index 0000000000000000000000000000000000000000..975f47d490da53b6f526d56166618f3994c327a0
--- /dev/null
+++ b/packages/core/tools/tests/output-validation.spec.ts
@@ -0,0 +1,108 @@
+import { describe, expect, expectTypeOf, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { type JsonValue, type ToolDefinition, type ToolExecutionToken } from '@deepseek-ai/dsh-tools'
+
+async function setup() {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  return ctx
+}
+
+function definition(validate: (value: JsonValue) => readonly string[]): ToolDefinition {
+  return {
+    name: 'checked', description: 'checked output', parameters: {},
+    output: {
+      schema: {}, validate,
+      render: () => [{ type: 'text', text: 'validated' }],
+    },
+    async execute() { return { count: 1 } },
+  }
+}
+
+function call(ctx: Context, nested = false, agent?: Agent) {
+  return ctx.tools.execute({
+    name: 'checked', arguments: {}, callId: ToolCallId('checked'),
+    signal: new AbortController().signal,
+    ...agent ? { agent } : {},
+    ...nested ? { parent: Symbol('parent') as ToolExecutionToken } : {},
+  })
+}
+
+describe('canonical output validation', () => {
+  it('excludes asynchronous validators from the author API', () => {
+    expectTypeOf<() => Promise<string[]>>().not.toExtend<NonNullable<ToolDefinition['output']['validate']>>()
+  })
+
+  it('rejects a malformed output validator during registration', async () => {
+    const ctx = await setup()
+    const tool = definition(() => [])
+    // Registration accepts plugin declarations at the existing runtime parser.
+    const output = { ...tool.output, validate: true } as unknown as ToolDefinition['output']
+    expect(() => ctx.tools.register({ ...tool, output })).toThrow('output.validate must be a function')
+  })
+
+  it('validates a detached deeply frozen value before projection', async () => {
+    const ctx = await setup()
+    const candidate = { nested: { count: 1 } }
+    let validated: JsonValue | undefined
+    const tool = definition((value) => {
+      validated = value
+      expect(value).not.toBe(candidate)
+      expect(Object.isFrozen(value)).toBe(true)
+      expect(Object.isFrozen((value as typeof candidate).nested)).toBe(true)
+      candidate.nested.count = 99
+      return []
+    })
+    tool.execute = async () => candidate
+    tool.output.render = (_args, value) => {
+      expect(value).toBe(validated)
+      return []
+    }
+    ctx.tools.register(tool)
+    expect(await call(ctx)).toMatchObject({ isError: false, value: { nested: { count: 1 } } })
+  })
+
+  it.each(['mutation', 'exception'] as const)('contains validator %s without disclosing exception text', async (mode) => {
+    const ctx = await setup()
+    ctx.tools.register(definition((value) => {
+      if (mode === 'mutation') {
+        (value as { count: number }).count = 99
+        return []
+      }
+      throw new Error('SECRET remote schema/data')
+    }))
+    const result = await call(ctx)
+    expect(result).toMatchObject({
+      isError: true, error: { message: 'tool "checked" returned invalid output: output.validate failed' },
+    })
+    expect(JSON.stringify(result)).not.toContain('SECRET')
+  })
+
+  it('checks the envelope before the additional validator', async () => {
+    const ctx = await setup()
+    let validated = false
+    const tool = definition(() => { validated = true; return [] })
+    const checked = { ...tool, output: { ...tool.output, schema: { type: 'string' as const } } }
+    ctx.tools.register(checked)
+    expect(await call(ctx)).toMatchObject({ isError: true })
+    expect(validated).toBe(false)
+  })
+
+  it.each([false, true])('rejects body output before projections (nested=%s)', async (nested) => {
+    const ctx = await setup()
+    let projected = false
+    const tool = definition(() => ['count must exceed 1'])
+    tool.output.render = () => { projected = true; return [] }
+    const dispose = ctx.tools.register(tool)
+    try {
+      expect(await call(ctx, nested)).toMatchObject({
+        isError: true, error: { message: 'tool "checked" returned invalid output: count must exceed 1' },
+      })
+      expect(projected).toBe(false)
+    } finally { dispose() }
+  })
+})
