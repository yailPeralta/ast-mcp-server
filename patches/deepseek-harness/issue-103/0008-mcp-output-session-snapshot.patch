+import { createInterface } from 'node:readline'
+
+// Raw JSON-RPC deliberately bypasses SDK server-side output validation.
+const tool = {
+  name: 'probe',
+  description: 'Return a valid or invalid email result.',
+  inputSchema: {
+    type: 'object',
+    properties: { valid: { type: 'boolean' } },
+    required: ['valid'],
+    additionalProperties: false,
+  },
+  outputSchema: {
+    type: 'object',
+    properties: { email: { type: 'string', format: 'email' } },
+    required: ['email'],
+    additionalProperties: false,
+  },
+}
+
+const input = createInterface({ input: process.stdin })
+for await (const line of input) {
+  const request = JSON.parse(line)
+  if (request.id === undefined) continue
+  let result
+  switch (request.method) {
+    case 'initialize':
+      result = {
+        protocolVersion: request.params.protocolVersion,
+        capabilities: { tools: {} },
+        serverInfo: { name: 'snapshot', version: '1.0.0' },
+      }
+      break
+    case 'tools/list':
+      result = { tools: [tool] }
+      break
+    case 'tools/call': {
+      if (request.params.name !== tool.name) throw new Error('Unknown tool')
+      const { valid } = request.params.arguments
+      result = {
+        content: [{ type: 'text', text: valid ? 'VALID' : 'INVALID MUST NOT LEAK' }],
+        structuredContent: { email: valid ? 'a@example.test' : 'not-an-email' },
+        isError: false,
+      }
+      break
+    }
+    case 'ping':
+      result = {}
+      break
+    default:
+      process.stdout.write(`${JSON.stringify({
+        jsonrpc: '2.0', id: request.id,
+        error: { code: -32601, message: 'Method not found' },
+      })}\n`)
+      continue
+  }
+  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', id: request.id, result })}\n`)
+}
