@@ -0,0 +1,9 @@
+export const name = 'snapshot-mcp-output-validation'
+export const inject = ['tools', 'agents']
+
+/** Restrict the real agent executor before its first request. */
+export function apply(ctx) {
+  ctx.on('agent/created', ({ agent }) => {
+    agent.ctx.tools.restrict({ allow: ['mcp__snapshot__probe'] })
+  })
+}
