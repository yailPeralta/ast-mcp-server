+      isError: false, content: [{ type: 'text', text: 'current finalizer' }],
+    })
+    expect(oldExecuted).toBe(false)
+  })
+
+  it.each(['wrapper', 'post'] as const)('keeps the owning validator across replacement in %s', async (path) => {
+    const ctx = await setup()
+    const oldTool = definition(value => (value as { count: number }).count === 1 ? [] : ['old count required'])
+    let dispose = ctx.tools.register(oldTool)
