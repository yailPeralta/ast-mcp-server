index 0000000000000000000000000000000000000000..6ecf9bed85e7a30d591f80cb1b9f1ef9ff89315d
--- /dev/null
+++ b/packages/mcp/mcp-client/tests/output-validation.spec.ts
@@ -0,0 +1,80 @@
+import { createHash } from 'node:crypto'
+import { describe, expect, it } from 'vitest'
+import { createOutputValidation } from '../src/output-validation.ts'
+
+const mismatch = ['structuredContent does not match the advertised MCP output schema']
+const objectSchema = {
+  type: 'object',
+  properties: { count: { type: 'integer', minimum: 1 } },
+  required: ['count'],
+  additionalProperties: false,
+}
+
+describe('standalone MCP output schema compiler', () => {
+  it.each([undefined, 'http://json-schema.org/draft-07/schema#'])(
+    'validates objects with dialect %s',
+    ($schema) => {
+      const schema = { ...objectSchema, ...($schema === undefined ? {} : { $schema }) }
+      const output = createOutputValidation(schema)
+      expect(output.validate!({ structuredContent: { count: 2 } })).toEqual([])
+      expect(output.validate!({ structuredContent: { count: 0 } })).toEqual(mismatch)
+      expect(output.validate!({ structuredContent: { count: '2' } })).toEqual(mismatch)
+      // Outer presence enforcement belongs to the bridge; this schema requires an object.
+      expect(output.validate!({ content: [] })).toEqual(mismatch)
+    },
+  )
+
+  it('uses draft 2020-12 assertions when no dialect is advertised', () => {
+    const output = createOutputValidation({
+      type: 'array', prefixItems: [{ type: 'integer' }], minItems: 1, items: false,
+    })
+    expect(output.validate!({ structuredContent: [1] })).toEqual([])
+    expect(output.validate!({ structuredContent: ['1'] })).toEqual(mismatch)
+    expect(output.validate!({ structuredContent: [1, 2] })).toEqual(mismatch)
+  })
+
+  it.each([
+    { type: 'object', privateKeyword: 'secret' },
+    { type: 'string', format: 'private-format' },
+    { $ref: 'https://private.example/schema' },
+  ])('sanitizes unsupported schema diagnostics: %j', (schema) => {
+    expect(() => createOutputValidation(schema)).toThrow(
+      new Error('MCP output schema is invalid or unsupported'),
+    )
+  })
+
+  it('reports absence without installing a validator', () => {
+    const output = createOutputValidation(undefined)
+    expect(output.validate).toBeUndefined()
+    expect(output.presentationMeta!({}, { content: [] })).toEqual({
+      mcpOutputValidation: { status: 'not-advertised' },
+    })
+  })
+
+  it('captures a schema clone and a digest immune to caller mutation', () => {
+    const schema = structuredClone(objectSchema)
+    const schemaSha256 = createHash('sha256').update(JSON.stringify(schema)).digest('hex')
+    const output = createOutputValidation(schema)
+    schema.properties.count.minimum = 100
+    schema.required.length = 0
+    expect(output.validate!({ structuredContent: { count: 2 } })).toEqual([])
+    expect(output.validate!({ structuredContent: {} })).toEqual(mismatch)
+    expect(output.presentationMeta!({}, { structuredContent: { count: 2 } })).toEqual({
+      mcpOutputValidation: { status: 'declared-schema-validated', schemaSha256 },
+    })
+  })
+
+  it('does not coerce values, insert defaults, or remove additional properties', () => {
+    const output = createOutputValidation({
+      ...objectSchema,
+      properties: { count: { type: 'integer', default: 1 } },
+    })
+    for (const structuredContent of [{ count: '2' }, {}, { count: 2, extra: true }]) {
+      const value = { structuredContent }
+      const before = structuredClone(value)
+      expect(output.validate!(value)).toEqual(mismatch)
+      expect(value).toEqual(before)
+    }
+    expect(output.validate!({ structuredContent: { count: 2 } })).toEqual([])
+  })
+})
