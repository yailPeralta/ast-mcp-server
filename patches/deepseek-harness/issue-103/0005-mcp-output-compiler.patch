diff --git a/packages/mcp/mcp-client/src/output-validation.ts b/packages/mcp/mcp-client/src/output-validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9b4b8b7f23670a018cddc914eeecd889b9ccdfc3
--- /dev/null
+++ b/packages/mcp/mcp-client/src/output-validation.ts
@@ -0,0 +1,122 @@
+/** Strict, registration-owned validation of advertised MCP structured results. */
+import { createHash } from 'node:crypto'
+import { Ajv } from 'ajv'
+import { Ajv2020 } from 'ajv/dist/2020.js'
+import addFormats, { type FormatName } from 'ajv-formats'
+import type { JsonValue, ToolOutputDefinition } from '@deepseek-ai/dsh-tools'
+
+const DRAFT7 = 'http://json-schema.org/draft-07/schema'
+const DRAFT2020 = 'https://json-schema.org/draft/2020-12/schema'
+// Ajv.getKeyword omits these standard declarations and annotations, which have no compiled rule.
+const DECLARATIONS_AND_ANNOTATIONS = new Set([
+  '$schema', '$id', '$defs', 'definitions', 'title', 'description', 'default', 'deprecated',
+  'readOnly', 'writeOnly', 'examples', 'contentMediaType', 'contentEncoding', 'contentSchema',
+])
+const SCHEMA_MAPS = new Set(['properties', 'patternProperties', '$defs', 'definitions', 'dependentSchemas', 'dependencies'])
+const SCHEMA_CHILDREN = new Set([
+  'items', 'additionalItems', 'additionalProperties', 'unevaluatedItems', 'unevaluatedProperties',
+  'contains', 'propertyNames', 'contentSchema', 'not', 'if', 'then', 'else', 'allOf', 'anyOf', 'oneOf', 'prefixItems',
+])
+
+function dialect(value: unknown): string {
+  const uri = value === undefined ? DRAFT2020 : typeof value === 'string' ? value.replace(/#$/, '') : ''
+  if (uri !== DRAFT7 && uri !== DRAFT2020) throw new Error('Unsupported MCP output schema dialect')
+  return uri
+}
+
+/** Visit schema positions only: property names, defaults and enum literals are data. */
+function assertSchemaPolicy(root: Record<string, unknown>, rootDialect: string, compiler: Ajv): void {
+  const pending: { value: unknown; path: string[] }[] = [{ value: root, path: [] }]
+  const locations = new Set<string>()
+  const references: string[] = []
+  for (let entry = pending.pop(); entry !== undefined; entry = pending.pop()) {
+    const { value, path } = entry
+    if (typeof value === 'boolean') {
+      locations.add(JSON.stringify(path))
+      continue
+    }
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) continue
+    locations.add(JSON.stringify(path))
+    const schema = value as Record<string, unknown>
+    if (['$async', '$vocabulary', '$anchor', '$dynamicRef', '$dynamicAnchor', '$recursiveRef', '$recursiveAnchor'].some(key => key in schema)
+      || (schema !== root && '$id' in schema)
+      || ('$schema' in schema && dialect(schema.$schema) !== rootDialect)) {
+      throw new Error('Unsupported MCP output schema declaration')
+    }
+    if (typeof schema.$ref === 'string') references.push(schema.$ref)
+    for (const [keyword, child] of Object.entries(schema)) {
+      // The public Ajv lookup also admits inherited Object.prototype names.
+      if (Object.hasOwn(Object.prototype, keyword)
+        || (!DECLARATIONS_AND_ANNOTATIONS.has(keyword) && !compiler.getKeyword(keyword))) {
+        throw new Error('Unsupported MCP output schema keyword')
+      }
+      if (keyword === 'format' && typeof child === 'string') {
+        if (Object.hasOwn(Object.prototype, child)) throw new Error('Unsupported MCP output schema format')
+        // The public lookup throws for unknown names; the wire supplies an arbitrary string.
+        addFormats.get(child as FormatName)
+      }
+      if (SCHEMA_MAPS.has(keyword) && typeof child === 'object' && child !== null && !Array.isArray(child)) {
+        for (const [key, nested] of Object.entries(child as Record<string, unknown>)) {
+          pending.push({ value: nested, path: [...path, keyword, key] })
+        }
+      } else if (SCHEMA_CHILDREN.has(keyword)) {
+        if (Array.isArray(child)) {
+          for (const [index, nested] of (child as unknown[]).entries()) {
+            pending.push({ value: nested, path: [...path, keyword, String(index)] })
+          }
+        } else pending.push({ value: child, path: [...path, keyword] })
+      }
+    }
+  }
+  for (const reference of references) {
+    if (!reference.startsWith('#')) throw new Error('Only local MCP output schema references are supported')
+    const pointer = decodeURIComponent(reference.slice(1))
+    if (pointer !== '' && !pointer.startsWith('/')) throw new Error('Unsupported MCP output schema anchor')
+    const path = (pointer === '' ? [] : pointer.slice(1).split('/')).map((token) => {
+      if (/~(?:[^01]|$)/.test(token)) throw new Error('Invalid MCP output schema pointer')
+      return token.replace(/~1/g, '/').replace(/~0/g, '~')
+    })
+    if (!locations.has(JSON.stringify(path))) {
+      throw new Error('MCP output schema reference targets an unsupported schema location')
+    }
+  }
+}
+
+/**
+ * Compile one immutable original schema without a cross-tool or cross-generation cache.
+ * Draft 2020-12 is the MCP default; explicit draft-07 is also supported. Compilation
+ * rejects other dialects, declarations and unknown assertions instead of downgrading.
+ * @param advertised - original MCP output schema, or absence for multi-format tools.
+ * @returns pure additional canonical-value validation and replayable status metadata.
+ */
+export function createOutputValidation(
+  advertised: Record<string, unknown> | undefined,
+): Pick<ToolOutputDefinition, 'validate' | 'presentationMeta'> {
+  if (advertised === undefined) {
+    return { presentationMeta: () => ({ mcpOutputValidation: { status: 'not-advertised' } }) }
+  }
+  try {
+    const schema = structuredClone(advertised)
+    const schemaDialect = dialect(schema.$schema)
+    const options = {
+      strict: true, validateSchema: true, validateFormats: true, allowUnionTypes: true,
+      allErrors: false, coerceTypes: false, useDefaults: false, removeAdditional: false,
+      ownProperties: true,
+    } as const
+    const compiler = schemaDialect === DRAFT7 ? new Ajv(options) : new Ajv2020(options)
+    addFormats(compiler)
+    assertSchemaPolicy(schema, schemaDialect, compiler)
+    const validate = compiler.compile(schema)
+    const schemaSha256 = createHash('sha256').update(JSON.stringify(schema)).digest('hex')
+    return {
+      validate(value: JsonValue) {
+        const structuredContent = (value as { structuredContent: JsonValue }).structuredContent
+        return validate(structuredContent) ? [] : ['structuredContent does not match the advertised MCP output schema']
+      },
+      presentationMeta: () => ({ mcpOutputValidation: { status: 'declared-schema-validated', schemaSha256 } }),
+    }
+  } catch {
+    // Compilation diagnostics can contain private schema data or reference URLs.
+    throw new Error('MCP output schema is invalid or unsupported')
+  }
+}
