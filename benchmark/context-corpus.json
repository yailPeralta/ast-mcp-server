{
  "schema_version": 1,
  "description": "Deterministic context-retrieval corpus for full-file, primitive and ast_explore workflows.",
  "scenarios": [
    {
      "id": "search_to_source",
      "description": "Find benchmarkTarget and return its exact implementation.",
      "query": "benchmarkTarget",
      "source_file": "src/shared.ts",
      "symbol_path": "benchmarkTarget",
      "full_files": ["src/shared.ts"],
      "required_evidence": ["export function benchmarkTarget", "return value + 1"],
      "accepted_call_bound": 2
    },
    {
      "id": "multi_file_references",
      "description": "Find benchmarkTarget and expose its declaration, import and call sites.",
      "query": "benchmarkTarget",
      "source_file": "src/shared.ts",
      "symbol_path": "benchmarkTarget",
      "full_files": ["src/shared.ts", "src/use.ts"],
      "include_references": true,
      "required_evidence": [
        "export function benchmarkTarget",
        "import { benchmarkTarget }",
        "benchmarkTarget(42)"
      ],
      "accepted_call_bound": 2
    },
    {
      "id": "exact_static_call_spine",
      "description": "Return benchmarkTarget source plus its authoritative incoming static call path.",
      "query": "benchmarkTarget",
      "source_file": "src/shared.ts",
      "symbol_path": "benchmarkTarget",
      "full_files": ["src/shared.ts", "src/use.ts"],
      "include_references": true,
      "required_evidence": ["export function benchmarkTarget", "benchmarkTarget(42)"],
      "required_explore_evidence": ["call_spines", "authority_state", "relationship_ids"],
      "explore_arguments": {
        "file_path": "src/shared.ts",
        "symbol_path": "benchmarkTarget",
        "detail": "full",
        "call_spines": { "direction": "incoming" },
        "max_bytes": 8192
      },
      "accepted_call_bound": 2
    }
  ]
}
