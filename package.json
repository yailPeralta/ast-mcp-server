{
  "name": "ast-mcp-server",
  "version": "0.13.0",
  "description": "Structural code MCP server and batch CLI for compact TypeScript/JavaScript reads and hash-bound AST edits.",
  "keywords": [
    "mcp",
    "typescript",
    "javascript",
    "ast",
    "ts-morph",
    "coding-agent",
    "refactoring"
  ],
  "license": "ISC",
  "author": "Yail Peralta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yailPeralta/ast-mcp-server.git"
  },
  "homepage": "https://github.com/yailPeralta/ast-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/yailPeralta/ast-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "yarn@4.15.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekHarness": {
    "revision": "cd5ef8148158c3a752a658978873241fdf8e2bbc",
    "tag": "dsh-v0.1.2-alpha.1",
    "mcpClientVersion": "0.1.2-alpha.1",
    "timeoutBudget": {
      "queueWaitMs": 30000,
      "executionDeadlineMs": 120000,
      "marginMs": 15000,
      "outerToolCallMs": 180000
    }
  },
  "main": "dist/index.js",
  "bin": {
    "ast-mcp-server": "dist/index.js",
    "ast-tool": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/support.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "resolutions": {
    "hono": "4.12.34",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --exclude test/supervised-worker.integration.test.ts && yarn build && vitest run test/supervised-worker.integration.test.ts --no-file-parallelism",
    "test:watch": "vitest",
    "test:mcp": "yarn build && node scripts/mcp-smoke.mjs",
    "test:lifecycle": "yarn build && node scripts/mcp-lifecycle-smoke.mjs",
    "test:cli": "yarn build && node scripts/cli-smoke.mjs",
    "test:errors": "yarn build && node scripts/public-error-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:dsh-adapter": "node scripts/dsh-adapter-smoke.mjs",
    "test:local-registry": "node scripts/local-registry-consumer-smoke.mjs",
    "test:installed-agents": "yarn build && node scripts/installed-agent-guidance-smoke.mjs",
    "test:agent-fixtures": "node scripts/admit-agent-fixtures.mjs --check",
    "test:release-candidate": "node scripts/release-candidate-matrix.mjs",
    "benchmark": "yarn build && node scripts/benchmark.mjs",
    "benchmark:corpus": "yarn build && node scripts/benchmark-corpus.mjs",
    "benchmark:batch": "yarn build && node scripts/benchmark-batch.mjs",
    "benchmark:formats": "yarn build && node scripts/benchmark-formats.mjs",
    "benchmark:shapes": "yarn build && node scripts/benchmark-result-shapes.mjs",
    "benchmark:agent-workflows": "yarn build && node scripts/benchmark-agent-workflows.mjs",
    "benchmark:index-storage": "yarn build && node scripts/benchmark-index-storage.mjs",
    "benchmark:index-integration": "yarn build && node scripts/benchmark-symbol-index-integration.mjs",
    "benchmark:production-readiness": "yarn build && node scripts/canary-local-mcp.mjs run",
    "benchmark:freeze-production-readiness": "node scripts/canary-local-mcp.mjs freeze-report-set",
    "lint": "eslint src test scripts vitest.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "yarn build",
    "audit": "yarn npm audit --all --recursive",
    "setup": "yarn build && node dist/cli.js setup",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@toon-format/toon": "4.1.0",
    "diff": "^9.0.0",
    "jsonc-parser": "^3.3.1",
    "ts-morph": "24.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.8.0",
    "gpt-tokenizer": "4.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
